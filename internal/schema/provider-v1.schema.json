{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-acme/schemas/provider-v1.schema.json",
  "title": "kg.provider/v1 describe manifest",
  "type": "object",
  "required": ["protocol", "protocol_versions", "provider", "capabilities"],
  "properties": {
    "protocol": {"const": "kg.provider/v1"},
    "protocol_versions": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "minItems": 1
    },
    "provider": {
      "type": "object",
      "required": ["id", "version", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "description": {"type": "string"}
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability_id", "title", "description", "side_effects", "input_schema", "output", "cli_spec"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "side_effects": {
            "type": "array",
            "items": {"enum": ["network", "data_egress", "downloads_models", "writes_db"]},
            "uniqueItems": true
          },
          "input_schema": {"type": "object"},
          "output": {
            "type": "object",
            "required": ["mode", "kind"],
            "properties": {
              "mode": {"enum": ["result-json", "artifact"]},
              "kind": {"enum": ["kg-document", "chunks", "communities", "json"]}
            },
            "additionalProperties": false
          },
          "cli_spec": {
            "type": "object",
            "required": ["subcommand", "always", "positionals", "flags"],
            "properties": {
              "subcommand": {"type": "array", "items": {"type": "string"}},
              "always": {"type": "array", "items": {"type": "string"}},
              "positionals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "required": {"type": "boolean"}
                  },
                  "additionalProperties": false
                }
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "flag", "kind"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "flag": {"type": "string", "minLength": 1},
                    "kind": {"enum": ["string", "number", "boolean", "array"]},
                    "optional": {"type": "boolean"},
                    "default": true,
                    "repeatable": {"type": "boolean"},
                    "join": {"type": "string"},
                    "stdout": {"type": "boolean"},
                    "order": {"type": "integer"},
                    "negated": {"type": "boolean"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
